{
  "name": "baseui-kit",
  "version": "0.2.0",
  "description": "A design system on Base UI: tokens, components and a documentation site built from them.",
  "type": "module",
  "license": "UNLICENSED",
  "devDependencies": {
    "@babel/parser": "^8.0.8",
    "@babel/types": "^8.0.8",
    "@tailwindcss/node": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "playwright": ">=1.56.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recast": "^0.24.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./components/*": "./src/components/*.js",
    "./icons/line": "./lib/line-HpXc8B8J.js",
    "./icons/solid": "./lib/solid-BKvSM0yD.js",
    "./tokens.css": "./tokens.css",
    "./components.css": "./src/components.css",
    "./styles.css": "./styles.css",
    "./registry.json": "./registry.json",
    "./package.json": "./package.json",
    "./tailwind.css": "./tailwind.css",
    "./constitution.md": "./CONSTITUTION.md",
    "./overgear": {
      "types": "./overgear/index.d.ts",
      "default": "./overgear/index.js"
    },
    "./overgear/constitution.md": "./overgear/CONSTITUTION.md"
  },
  "files": [
    "src",
    "!src/stories",
    "!src/foundations",
    "!src/theming/*.stories.js",
    "!src/tools",
    "lib",
    "types",
    "fonts",
    "tokens.css",
    "styles.css",
    "registry.json",
    "README.md",
    "CHANGELOG.md",
    "tailwind.css",
    "CONSTITUTION.md",
    "overgear/index.js",
    "overgear/index.d.ts",
    "overgear/ConstitutionBanner.js",
    "overgear/constitution/rules.js",
    "overgear/CONSTITUTION.md",
    "overgear/AGENTS.md",
    "overgear/CLAUDE.md",
    "overgear/README.md"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0"
  },
  "scripts": {
    "vendor": "node tools/build/vendor.mjs",
    "registry": "node tools/build/registry.mjs",
    "types": "node tools/build/types.mjs",
    "build": "npm run build:js && npm run constitution && npm run registry && npm run types && npm run tailwind",
    "pretest": "node tools/build/js.mjs && npm run constitution && npm run registry && npm run types",
    "test": "vitest run",
    "build:js": "node tools/build/js.mjs",
    "dev": "node tools/build/js.mjs --watch",
    "prepack": "npm run build",
    "typecheck": "node tools/check/typecheck.mjs",
    "tailwind": "node tools/build/tailwind.mjs",
    "constitution": "node tools/build/constitution.mjs && node overgear/tools/build/constitution.mjs",
    "check:constitution": "node tools/check/constitution.mjs",
    "check:spacing": "node tools/check/spacing.mjs",
    "check:overgear:spacing": "node overgear/tools/check/spacing.mjs",
    "check": "node tools/check/all.mjs",
    "verify": "npm run typecheck && npm test && npm run check",
    "check:generated": "npm run build && git diff --exit-code -- registry.json r types tailwind.css CONSTITUTION.md AGENTS.md CLAUDE.md overgear/CONSTITUTION.md overgear/AGENTS.md overgear/CLAUDE.md"
  }
}
